# Copy to .env and fill in the real values. .env is gitignored.

# Supabase pooler connection string (Project Settings → Database → Connection string → URI).
# Use the transaction pooler on port 6543 so serverless deployments do not exhaust connections.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Change this in production — it signs the login tokens.
JWT_SECRET=change-me

# Optional: maximum Postgres connections per process (default 3).
# PG_POOL_MAX=3
