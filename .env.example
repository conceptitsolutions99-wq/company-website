# Copy to .env and fill in the real values. .env is gitignored.

# Supabase pooler connection string (Project Settings → Database → Connection string → URI).
# Use the transaction pooler on port 6543 so serverless deployments do not exhaust connections.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Where enquiries and service requests are delivered.
# Defaults to conceptitsolutions99@gmail.com when unset.
# CONTACT_EMAIL=conceptitsolutions99@gmail.com

# Sending mailbox. For a Google account create an App Password
# (Google Account → Security → 2-Step Verification → App passwords) and use it as SMTP_PASS.
# Without these two values the site still runs, but the forms report that email is not configured.
SMTP_USER=conceptitsolutions99@gmail.com
SMTP_PASS=your-16-character-app-password

# Optional overrides (defaults shown).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Optional: maximum Postgres connections per process (default 3).
# PG_POOL_MAX=3
