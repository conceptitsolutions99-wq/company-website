<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Dashboard - True Concept</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Outfit:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="logo">
                <span class="logo-icon">◆</span>
                True Concept
            </a>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/services">Services</a></li>
                <li><a href="/dashboard" class="active">Dashboard</a></li>
            </ul>
            <div class="nav-user">
                <span>Welcome, <%= user.name %></span>
                <a href="/api/auth/logout" class="btn btn-outline btn-sm">Logout</a>
            </div>
        </div>
    </nav>

    <section class="dashboard-section">
        <div class="container">
            <div class="dashboard-header">
                <div class="dashboard-welcome">
                    <h1>My Dashboard</h1>
                    <p>Track your service requests and their status</p>
                </div>
                <a href="/services" class="btn btn-primary">
                    Request New Service
                    <span class="btn-arrow">→</span>
                </a>
            </div>

            <div class="dashboard-stats">
                <div class="stat-box">
                    <div class="stat-value" id="totalRequests"><%= requests ? requests.length : 0 %></div>
                    <div class="stat-label">Total Requests</div>
                </div>
                <div class="stat-box pending">
                    <div class="stat-value" id="pendingRequests"><%= requests ? requests.filter(r => r.status === 'pending').length : 0 %></div>
                    <div class="stat-label">Pending</div>
                </div>
                <div class="stat-box approved">
                    <div class="stat-value" id="approvedRequests"><%= requests ? requests.filter(r => r.status === 'approved').length : 0 %></div>
                    <div class="stat-label">Approved</div>
                </div>
            </div>

            <div class="dashboard-content">
                <h2>My Service Requests</h2>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-error"><%= error %></div>
                <% } %>

                <% if (requests && requests.length > 0) { %>
                    <div class="requests-list">
                        <% requests.forEach(request => { %>
                            <div class="request-card">
                                <div class="request-header">
                                    <h3><%= request.service_name %></h3>
                                    <span class="request-status status-<%= request.status %>">
                                        <%= request.status.charAt(0).toUpperCase() + request.status.slice(1) %>
                                    </span>
                                </div>
                                <div class="request-details">
                                    <p><strong>Details:</strong> <%= request.details %></p>
                                    <p><strong>Submitted:</strong> <%= new Date(request.created_at).toLocaleDateString() %></p>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <div class="empty-icon">📋</div>
                        <h3>No Requests Yet</h3>
                        <p>You haven't submitted any service requests yet.</p>
                        <a href="/services" class="btn btn-primary">Browse Services</a>
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <script>
        // Could add real-time updates here
    </script>
</body>
</html>