<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - True Concept</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Outfit:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <nav class="navbar admin-nav">
        <div class="nav-container">
            <a href="/" class="logo">
                <span class="logo-icon">◆</span>
                True Concept
            </a>
            <ul class="nav-links">
                <li><a href="/admin/dashboard" class="active">Dashboard</a></li>
                <li><a href="/admin/services">Services</a></li>
                <li><a href="/admin/requests">Requests</a></li>
            </ul>
            <div class="nav-user">
                <span>Admin</span>
                <a href="/api/auth/logout" class="btn btn-outline btn-sm">Logout</a>
            </div>
        </div>
    </nav>

    <section class="admin-section">
        <div class="container">
            <div class="admin-header">
                <h1>Admin Dashboard</h1>
                <p>Manage services and customer requests</p>
            </div>

            <div class="admin-stats">
                <div class="stat-card admin-stat">
                    <div class="stat-icon">📦</div>
                    <div class="stat-content">
                        <div class="stat-value"><%= services ? services.length : 0 %></div>
                        <div class="stat-label">Total Services</div>
                    </div>
                </div>
                <div class="stat-card admin-stat">
                    <div class="stat-icon">📋</div>
                    <div class="stat-content">
                        <div class="stat-value"><%= requests ? requests.length : 0 %></div>
                        <div class="stat-label">Total Requests</div>
                    </div>
                </div>
                <div class="stat-card admin-stat pending">
                    <div class="stat-icon">⏳</div>
                    <div class="stat-content">
                        <div class="stat-value"><%= requests ? requests.filter(r => r.status === 'pending').length : 0 %></div>
                        <div class="stat-label">Pending Requests</div>
                    </div>
                </div>
            </div>

            <div class="admin-quick-actions">
                <a href="/admin/services/add" class="action-card">
                    <div class="action-icon">➕</div>
                    <div class="action-text">
                        <h3>Add New Service</h3>
                        <p>Create a new service offering</p>
                    </div>
                </a>
                <a href="/admin/services" class="action-card">
                    <div class="action-icon">⚙️</div>
                    <div class="action-text">
                        <h3>Manage Services</h3>
                        <p>Edit or delete existing services</p>
                    </div>
                </a>
                <a href="/admin/requests" class="action-card">
                    <div class="action-icon">📥</div>
                    <div class="action-text">
                        <h3>View Requests</h3>
                        <p>Process customer service requests</p>
                    </div>
                </a>
            </div>

            <% if (requests && requests.length > 0) { %>
                <div class="admin-recent">
                    <h2>Recent Requests</h2>
                    <div class="requests-table-wrapper">
                        <table class="requests-table">
                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Service</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% requests.slice(0, 5).forEach(request => { %>
                                    <tr>
                                        <td><%= request.user_name %></td>
                                        <td><%= request.service_name %></td>
                                        <td>
                                            <span class="status-badge status-<%= request.status %>">
                                                <%= request.status.charAt(0).toUpperCase() + request.status.slice(1) %>
                                            </span>
                                        </td>
                                        <td><%= new Date(request.created_at).toLocaleDateString() %></td>
                                        <td>
                                            <a href="/admin/requests" class="btn btn-sm btn-outline">View</a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } %>
        </div>
    </section>

    <script src="/js/app.js"></script>
</body>
</html>