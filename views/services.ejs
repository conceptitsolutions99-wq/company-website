<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Services — True Concept</title>
    <meta name="description" content="Custom software, web platforms, mobile apps, cloud infrastructure, networks and security systems from True Concept.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,700;12..96,800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/home.css">
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('theme');
                var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (dark) document.documentElement.setAttribute('data-theme', 'dark');
            } catch (e) { /* private mode */ }
        })();
    </script>
</head>
<body>

<header class="nav" id="nav">
    <div class="nav-inner">
        <a href="/" class="brand" aria-label="True Concept">
            <span class="brand-mark" aria-hidden="true"></span>
            <span class="brand-name">True Concept</span>
        </a>
        <nav class="nav-links" id="navLinks" aria-label="Primary">
            <a href="/#work">Work</a>
            <a href="/services">Services</a>
            <a href="/#about">About</a>
            <a href="/#brief">Start a project</a>
        </nav>
        <div class="nav-actions">
            <button class="theme-btn" id="themeToggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" title="Switch theme">
                <span class="theme-icon" aria-hidden="true">☾</span>
            </button>
            <a class="btn-solid" href="/#brief">Start a project</a>
        </div>
        <button class="burger" id="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="navLinks">
            <span></span><span></span>
        </button>
    </div>
</header>

<main id="main">
    <section class="section page">
        <div class="wrap">
            <div class="page-head">
                <p class="label">Our services</p>
                <h2 class="h2">
                    Technology that runs<br>
                    <span class="muted">your operation.</span>
                </h2>
                <p class="lede">
                    Six disciplines, one team. Every engagement starts with how the business actually
                    works today — then we build the smallest system that removes the friction.
                </p>
            </div>

            <% if (typeof catalogue !== 'undefined' && catalogue && catalogue.length > 0) { %>
                <div class="cat-grid">
                    <% catalogue.forEach(service => { %>
                        <article class="cat-card">
                            <h3><%= service.name %></h3>
                            <p><%= service.description %></p>
                            <div class="cat-meta">
                                <span class="cat-price">
                                    <span>Starting from</span>
                                    EGP <%= Number(service.price).toLocaleString() %>
                                </span>
                                <a class="btn-outline" href="/request/<%= service.id %>">Request</a>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="cat-grid">
                    <article class="cat-card">
                        <h3>Custom software</h3>
                        <p>Internal tools, enterprise systems and integrations built around the way your company really works.</p>
                    </article>
                    <article class="cat-card">
                        <h3>Web platforms</h3>
                        <p>Fast, accessible sites and web applications on a modern stack, designed to last.</p>
                    </article>
                    <article class="cat-card">
                        <h3>Mobile apps</h3>
                        <p>Native and cross-platform apps for iOS and Android, from prototype through store release.</p>
                    </article>
                    <article class="cat-card">
                        <h3>Cloud &amp; infrastructure</h3>
                        <p>Migration, hosting and infrastructure management that scales without cost surprises.</p>
                    </article>
                    <article class="cat-card">
                        <h3>Networks</h3>
                        <p>Reliable network design, installation and maintenance for offices, branches and sites.</p>
                    </article>
                    <article class="cat-card">
                        <h3>CCTV &amp; security</h3>
                        <p>Surveillance, access control and security hardening for your premises and your data.</p>
                    </article>
                </div>
            <% } %>

            <div class="page-cta">
                <a class="btn-solid btn-lg" href="/#brief">
                    <span>Start a project</span>
                    <span class="arrow" aria-hidden="true">↗</span>
                </a>
                <a class="btn-outline btn-lg" href="mailto:<%= contactEmail %>"><%= contactEmail %></a>
            </div>
        </div>
    </section>
</main>

<footer class="footer">
    <div class="wrap">
        <div class="footer-bottom" style="margin-top:0; border-top:0; padding-top:0;">
            <p>&copy; <span id="year">2026</span> True Concept</p>
            <p><a href="/">true concept — back to home</a></p>
        </div>
    </div>
</footer>

<script src="/js/home.js"></script>
</body>
</html>
