<!DOCTYPE html>
<html lang="en" dir="ltr">
<%- include('partials/head', {
    title: 'Services — True Concept',
    description: 'Custom software, web platforms, mobile apps, cloud infrastructure, networks and security systems from True Concept.',
    path: '/services'
}) %>
<body>

<%- include('partials/nav') %>

<%
const cards = (Array.isArray(catalogue) && catalogue.length > 0)
    ? catalogue.map((service) => ({
        name: service.name,
        description: service.description,
        price: Number(service.price),
        href: '/request/' + service.id
    }))
    : [
        { name: 'Custom software', description: 'Internal tools, enterprise systems and integrations built around the way your company really works.' },
        { name: 'Web platforms', description: 'Fast, accessible sites and web applications on a modern stack, designed to last.' },
        { name: 'Mobile apps', description: 'Native and cross-platform apps for iOS and Android, from prototype through store release.' },
        { name: 'Cloud & infrastructure', description: 'Migration, hosting and infrastructure management that scales without cost surprises.' },
        { name: 'Networks', description: 'Reliable network design, installation and maintenance for offices, branches and sites.' },
        { name: 'CCTV & security', description: 'Surveillance, access control and security hardening for your premises and your data.' }
    ];
%>

<main id="main">
    <section class="section page">
        <div class="wrap">
            <div class="page-head">
                <p class="label">Our services</p>
                <h2 class="h2">
                    Technology that runs<br>
                    <span class="muted">your operation.</span>
                </h2>
                <p class="lede">
                    Six disciplines, one team. Every engagement starts with how the business actually
                    works today — then we build the smallest system that removes the friction.
                </p>
            </div>

            <div class="cat-grid">
                <% cards.forEach((card) => { %>
                    <article class="cat-card">
                        <h3><%= card.name %></h3>
                        <p><%= card.description %></p>
                        <% if (card.price) { %>
                            <div class="cat-meta">
                                <span class="cat-price">
                                    <span>Starting from</span>
                                    EGP <%= card.price.toLocaleString() %>
                                </span>
                                <a class="btn-outline" href="<%= card.href %>">Request</a>
                            </div>
                        <% } %>
                    </article>
                <% }) %>
            </div>

            <div class="page-cta">
                <a class="btn-solid btn-lg" href="/#brief">
                    <span>Start a project</span>
                    <span class="arrow" aria-hidden="true">↗</span>
                </a>
                <a class="btn-outline btn-lg" href="mailto:<%= contactEmail %>"><%= contactEmail %></a>
            </div>
        </div>
    </section>
</main>

<footer class="footer">
    <div class="wrap">
        <div class="footer-bottom" style="margin-top:0; border-top:0; padding-top:0;">
            <p>&copy; <span id="year">2026</span> True Concept</p>
            <p><a href="/">True Concept — back to home</a></p>
        </div>
    </div>
</footer>

<script src="/js/home.js"></script>
</body>
</html>
