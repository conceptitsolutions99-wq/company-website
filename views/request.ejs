<!DOCTYPE html>
<html lang="en" dir="ltr">
<%- include('partials/head', {
    title: 'Request ' + service.name + ' — True Concept',
    path: '/request/' + service.id
}) %>
<body>

<%- include('partials/nav', { navClass: 'nav-dark' }) %>

<main id="main">
    <section class="section brief req-section">
        <div class="wrap req-grid">
            <div class="brief-copy">
                <p class="label label-light" data-i18n="req.label">Request a service</p>
                <h2 class="h2 h2-light">
                    <span><%= service.name %></span><br>
                    <span class="muted-light" data-i18n="req.title2">let's scope it.</span>
                </h2>
                <p class="about-p"><%= service.description %></p>

                <ul class="brief-points">
                    <li><span aria-hidden="true">✳</span><span><span data-i18n="common.from">Starting from</span> EGP <%= Number(service.price).toLocaleString() %></span></li>
                    <li><span aria-hidden="true">✳</span><span data-i18n="req.point2">A reply within one working day</span></li>
                    <li><span aria-hidden="true">✳</span><span data-i18n="req.point3">Fixed-scope estimate before any code</span></li>
                </ul>

                <p class="brief-fine req-fine">
                    <span data-i18n="req.fine1">Your details go straight to</span>
                    <a href="mailto:<%= contactEmail %>"><%= contactEmail %></a>
                    <span data-i18n="req.fine2">— we keep them only to answer your enquiry, and never share them.</span>
                </p>
            </div>

            <div class="brief-card">
                <form id="requestForm" novalidate>
                    <p class="brief-q" data-i18n="req.intro">Tell us about the project</p>

                    <div class="hp-field" aria-hidden="true">
                        <label for="requestWebsite">Website</label>
                        <input type="text" id="requestWebsite" name="website" tabindex="-1" autocomplete="off">
                    </div>

                    <label class="field">
                        <span data-i18n="req.name">Your name</span>
                        <input type="text" id="name" name="name" autocomplete="name" required minlength="2">
                    </label>

                    <label class="field">
                        <span data-i18n="req.email">Email</span>
                        <input type="email" id="email" name="email" autocomplete="email" required>
                    </label>

                    <label class="field">
                        <span data-i18n="req.phone">Phone (optional)</span>
                        <input type="tel" id="phone" name="phone" autocomplete="tel">
                    </label>

                    <label class="field">
                        <span data-i18n="req.details">Project details</span>
                        <textarea id="details" name="details" rows="5" required minlength="20"
                            placeholder="What are you building, and by when?"
                            data-i18n-placeholder="req.detailsPh"></textarea>
                    </label>

                    <p class="brief-error" id="formError" role="alert"></p>

                    <div class="brief-actions">
                        <button type="submit" class="btn-solid btn-full">
                            <span data-i18n="req.send">Send request</span>
                            <span class="arrow" aria-hidden="true">↗</span>
                        </button>
                    </div>
                </form>

                <div id="successMessage" style="display:none;">
                    <p class="brief-q" data-i18n="req.sentTitle">Request sent</p>
                    <p class="brief-fine req-fine" style="margin-top:.6rem;">
                        <span data-i18n="req.sent1">It is on its way to</span>
                        <%= contactEmail %>. <span data-i18n="req.sent2">We will reply to your email within one working day.</span>
                    </p>
                    <div class="brief-actions">
                        <a class="btn-solid btn-full" href="/" data-i18n="common.backHome">Back to home</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<script>
    document.getElementById('requestForm').addEventListener('submit', function (event) {
        event.preventDefault();

        var form = event.target;
        var button = form.querySelector('button[type="submit"]');
        var errorEl = document.getElementById('formError');
        var name = document.getElementById('name').value.trim();
        var email = document.getElementById('email').value.trim();
        var details = document.getElementById('details').value.trim();
        // Arabic copy lives in home.js; the English stays here as the fallback.
        var say = function (key, english) {
            return window.tcSay ? window.tcSay(key, english) : english;
        };

        if (name.length < 2 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            errorEl.textContent = say('req.errName', 'Please add your name and a valid email address.');
            return;
        }
        if (details.length < 20) {
            errorEl.textContent = say('req.errDetails', 'Please describe the project in at least 20 characters.');
            return;
        }

        errorEl.textContent = '';
        button.disabled = true;
        button.textContent = say('req.sending', 'Sending…');

        window.tcSendEnquiry({
            type: 'service',
            service: <%- JSON.stringify(service.name) %>,
            name: name,
            email: email,
            phone: document.getElementById('phone').value.trim(),
            website: document.getElementById('requestWebsite').value,
            message: details
        })
            .then(function () {
                form.style.display = 'none';
                document.getElementById('successMessage').style.display = 'block';
            })
            .catch(function (error) {
                errorEl.textContent = error.message;
                button.disabled = false;
                button.textContent = say('req.send', 'Send request');
            });
    });
</script>
<script src="/js/home.js"></script>
</body>
</html>
