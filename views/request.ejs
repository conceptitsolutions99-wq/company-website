<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Request <%= service.name %> — True Concept</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,700;12..96,800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/home.css">
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('theme');
                var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (dark) document.documentElement.setAttribute('data-theme', 'dark');
            } catch (e) { /* private mode */ }
        })();
    </script>
</head>
<body>

<header class="nav" id="nav">
    <div class="nav-inner">
        <a href="/" class="brand" aria-label="True Concept">
            <span class="brand-mark" aria-hidden="true"></span>
            <span class="brand-name">True Concept</span>
        </a>
        <nav class="nav-links" id="navLinks" aria-label="Primary">
            <a href="/#work">Work</a>
            <a href="/services">Services</a>
            <a href="/#about">About</a>
            <a href="/#brief">Start a project</a>
        </nav>
        <div class="nav-actions">
            <button class="theme-btn" id="themeToggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" title="Switch theme">
                <span class="theme-icon" aria-hidden="true">☾</span>
            </button>
            <a class="btn-solid" href="/#brief">Start a project</a>
        </div>
        <button class="burger" id="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="navLinks">
            <span></span><span></span>
        </button>
    </div>
</header>

<main id="main">
    <section class="section brief" style="padding-top: clamp(7rem, 12vw, 10rem);">
        <div class="wrap req-grid">
            <div class="brief-copy">
                <p class="label label-light">Request a service</p>
                <h2 class="h2 h2-light">
                    <span><%= service.name %></span><br>
                    <span class="muted-light">let's scope it.</span>
                </h2>
                <p class="about-p"><%= service.description %></p>

                <ul class="brief-points">
                    <li><span aria-hidden="true">✳</span><span>Starting from EGP <%= Number(service.price).toLocaleString() %></span></li>
                    <li><span aria-hidden="true">✳</span><span>A reply within one working day</span></li>
                    <li><span aria-hidden="true">✳</span><span>Fixed-scope estimate before any code</span></li>
                </ul>

                <p class="brief-fine" style="max-width:34ch;">
                    Your details go straight to <a href="mailto:<%= contactEmail %>"><%= contactEmail %></a> — nothing is stored on this site.
                </p>
            </div>

            <div class="brief-card">
                <form id="requestForm" novalidate>
                    <p class="brief-q">Tell us about the project</p>

                    <label class="field">
                        <span>Your name</span>
                        <input type="text" id="name" name="name" autocomplete="name" required minlength="2">
                    </label>

                    <label class="field">
                        <span>Email</span>
                        <input type="email" id="email" name="email" autocomplete="email" required>
                    </label>

                    <label class="field">
                        <span>Phone (optional)</span>
                        <input type="tel" id="phone" name="phone" autocomplete="tel">
                    </label>

                    <label class="field">
                        <span>Project details</span>
                        <textarea id="details" name="details" rows="5" required minlength="20"
                            placeholder="What are you building, and by when?"></textarea>
                    </label>

                    <p class="brief-error" id="formError" role="alert"></p>

                    <div class="brief-actions">
                        <button type="submit" class="btn-solid btn-full">
                            <span>Send request</span>
                            <span class="arrow" aria-hidden="true">↗</span>
                        </button>
                    </div>
                </form>

                <div id="successMessage" style="display:none;">
                    <p class="brief-q">Request sent</p>
                    <p class="brief-fine" style="margin-top:.6rem;">
                        It is on its way to <%= contactEmail %>. We will reply to your email within one working day.
                    </p>
                    <div class="brief-actions">
                        <a class="btn-solid btn-full" href="/">Back to home</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<script>
    document.getElementById('requestForm').addEventListener('submit', function (event) {
        event.preventDefault();

        var form = event.target;
        var button = form.querySelector('button[type="submit"]');
        var errorEl = document.getElementById('formError');
        var name = document.getElementById('name').value.trim();
        var email = document.getElementById('email').value.trim();
        var phone = document.getElementById('phone').value.trim();
        var details = document.getElementById('details').value.trim();

        if (name.length < 2 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            errorEl.textContent = 'Please add your name and a valid email address.';
            return;
        }
        if (details.length < 20) {
            errorEl.textContent = 'Please describe the project in at least 20 characters.';
            return;
        }

        errorEl.textContent = '';
        button.disabled = true;
        button.textContent = 'Sending…';

        fetch('/api/enquiry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                type: 'service',
                service: <%- JSON.stringify(service.name) %>,
                name: name,
                email: email,
                phone: phone,
                message: details
            })
        })
            .then(function (response) {
                return response.json().catch(function () { return {}; }).then(function (data) {
                    if (!response.ok) throw new Error(data.error || 'Could not send your request.');
                    return data;
                });
            })
            .then(function () {
                form.style.display = 'none';
                document.getElementById('successMessage').style.display = 'block';
            })
            .catch(function (error) {
                errorEl.textContent = error.message || 'Could not send your request.';
                button.disabled = false;
                button.textContent = 'Send request';
            });
    });
</script>
<script src="/js/home.js"></script>
</body>
</html>
