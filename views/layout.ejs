<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'True Concept' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Outfit:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <nav class="navbar" id="navbar">
        <div class="nav-container">
            <a href="/" class="logo">
                <span class="logo-icon">◆</span>
                True Concept
            </a>
            <ul class="nav-links" id="navLinks">
                <li><a href="/">Home</a></li>
                <li><a href="/services">Services</a></li>
                <% if (typeof user !== 'undefined' && user) { %>
                    <% if (user.role === 'admin') { %>
                        <li><a href="/admin/dashboard">Admin Dashboard</a></li>
                    <% } else { %>
                        <li><a href="/dashboard">Dashboard</a></li>
                    <% } %>
                    <li><a href="/api/auth/logout">Logout</a></li>
                <% } else { %>
                    <li><a href="/login">Login</a></li>
                    <li><a href="/register">Register</a></li>
                <% } %>
                <li><a href="#" class="btn btn-outline" id="langToggle" style="margin-left: 8px;">AR / EN</a></li>
            </ul>
            <button class="hamburger" id="hamburger" aria-label="Toggle menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </nav>

    <main class="main-content">
        <%- body %>
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <a href="/" class="logo">
                        <span class="logo-icon">◆</span>
                        True Concept
                    </a>
                    <p>Delivering innovative technology solutions for modern businesses.</p>
                </div>
                <div class="footer-links">
                    <h4>Services</h4>
                    <ul>
                        <li><a href="/services">Browse Services</a></li>
                        <li><a href="/services">Mobile App Dev</a></li>
                        <li><a href="/services">Web Development</a></li>
                        <li><a href="/services">Network Solutions</a></li>
                    </ul>
                </div>
                <div class="footer-links">
                    <h4>Company</h4>
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/services">Services</a></li>
                        <% if (typeof user !== 'undefined' && user) { %>
                            <li><a href="/dashboard">My Dashboard</a></li>
                        <% } else { %>
                            <li><a href="/login">Login</a></li>
                        <% } %>
                    </ul>
                </div>
                <div class="footer-links">
                    <h4>Contact</h4>
                    <ul>
                        <li>hello@trueconcept.com</li>
                        <li>+1 (555) 123-4567</li>
                        <li>San Francisco, CA</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2024 True Concept. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="/js/app.js"></script>
</body>
</html>