<!DOCTYPE html>
<html lang="en" dir="ltr">
<%- include('partials/head', {
    title: 'Not found — True Concept',
    path: '/404',
    noindex: true
}) %>
<body>

<%- include('partials/nav') %>

<main id="main">
    <section class="section error-wrap">
        <div class="wrap">
            <p class="label">404</p>
            <h1 class="h2">
                <span data-i18n="err.title1">That page</span><br>
                <span class="muted" data-i18n="err.title2">is not here.</span>
            </h1>
            <p class="lede">
                <span data-i18n="<%= typeof errorKey !== 'undefined' ? errorKey : 'err.page' %>"><%= error %></span>
                <span data-i18n="err.hint">— head back to the homepage and pick up from there.</span>
            </p>
            <div class="page-cta" style="justify-content:center;">
                <a class="btn-solid btn-lg" href="/">
                    <span data-i18n="common.backHome">Back to home</span>
                    <span class="arrow" aria-hidden="true">↗</span>
                </a>
            </div>
        </div>
    </section>
</main>

<script src="/js/home.js"></script>
</body>
</html>
