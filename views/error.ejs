<!DOCTYPE html>
<html lang="en" dir="ltr">
<%- include('partials/head', {
    title: 'Not found — True Concept',
    path: '/404',
    noindex: true
}) %>
<body>

<%- include('partials/nav') %>

<main id="main">
    <section class="section error-wrap">
        <div class="wrap">
            <p class="label">404</p>
            <h1 class="h2">
                That page<br><span class="muted">is not here.</span>
            </h1>
            <p class="lede"><%= error %> — head back to the homepage and pick up from there.</p>
            <div class="page-cta" style="justify-content:center;">
                <a class="btn-solid btn-lg" href="/">
                    <span>Back to home</span>
                    <span class="arrow" aria-hidden="true">↗</span>
                </a>
            </div>
        </div>
    </section>
</main>

<script src="/js/home.js"></script>
</body>
</html>
