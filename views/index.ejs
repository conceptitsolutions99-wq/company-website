    <!-- ============ SERVICES ============ -->
    <section class="section services" id="services">
        <div class="wrap">
            <div class="section-head">
                <p class="label" data-i18n="services.label">What we do</p>
                <h2 class="h2">
                    <span data-i18n="services.title">Six disciplines,</span><br>
                    <span class="muted" data-i18n="services.title2">one team.</span>
                </h2>
                <p class="lede" data-i18n="services.lede">
                    We keep the strategy, the design and the engineering in the same room, so
                    nothing gets lost between the brief and the build.
                </p>
            </div>

            <ol class="service-list">
                <li class="service-row">
                    <span class="service-num">01</span>
                    <div class="service-body">
                        <h3 data-i18n="svc.1.name">Custom software</h3>
                        <p data-i18n="svc.1.desc">Enterprise systems, internal tools and integrations shaped around the way your business actually runs.</p>
                    </div>
                    <span class="service-arrow" aria-hidden="true">↗</span>
                </li>
                <li class="service-row">
                    <span class="service-num">02</span>
                    <div class="service-body">
                        <h3 data-i18n="svc.2.name">Web platforms</h3>
                        <p data-i18n="svc.2.desc">Fast, accessible websites and web applications built on modern stacks and engineered to last.</p>
                    </div>
                    <span class="service-arrow" aria-hidden="true">↗</span>
                </li>
                <li class="service-row">
                    <span class="service-num">03</span>
                    <div class="service-body">
                        <h3 data-i18n="svc.3.name">Mobile apps</h3>
                        <p data-i18n="svc.3.desc">Native and cross-platform apps for iOS and Android, from first prototype through to store release.</p>
                    </div>
                    <span class="service-arrow" aria-hidden="true">↗</span>
                </li>
                <li class="service-row">
                    <span class="service-num">04</span>
                    <div class="service-body">
                        <h3 data-i18n="svc.4.name">Cloud &amp; infrastructure</h3>
                        <p data-i18n="svc.4.desc">Migration, hosting and managed infrastructure that scales without nasty surprises on the invoice.</p>
                    </div>
                    <span class="service-arrow" aria-hidden="true">↗</span>
                </li>
                <li class="service-row">
                    <span class="service-num">05</span>
                    <div class="service-body">
                        <h3 data-i18n="svc.5.name">Networks</h3>
                        <p data-i18n="svc.5.desc">Design, installation and maintenance of reliable office, branch and site networks.</p>
                    </div>
                    <span class="service-arrow" aria-hidden="true">↗</span>
                </li>
                <li class="service-row">
                    <span class="service-num">06</span>
                    <div class="service-body">
