    <!-- ============ STUDIO ============ -->
    <section class="section about" id="about">
        <div class="wrap about-grid">
            <div class="about-copy">
                <p class="label label-light" data-i18n="about.label">About us</p>
                <h2 class="h2 h2-light">
                    <span data-i18n="about.title">We are the technical partner</span>
                    <span class="muted-light" data-i18n="about.title2">behind the operations.</span>
                </h2>
                <p class="about-p" data-i18n="about.p1">
                    Since 2019 we have been helping businesses put technology to work — replacing
                    spreadsheets with systems, paper with platforms, and guesswork with data.
                </p>
                <p class="about-p" data-i18n="about.p2">
                    Our mission is simple: build software that removes friction from the way our
                    clients work, then stay long enough to keep it that way.
                </p>
                <a href="#brief" class="btn-light">
                    <span data-i18n="about.cta">Work with us</span>
                    <span class="arrow" aria-hidden="true">↗</span>
                </a>
            </div>

            <div class="stats">
                <div class="stat">
                    <span class="stat-num">2019</span>
                    <span class="stat-label" data-i18n="stat.1">Studio founded</span>
                </div>
                <div class="stat">
                    <span class="stat-num">8</span>
                    <span class="stat-label" data-i18n="stat.2">Products shipped</span>
                </div>
                <div class="stat">
                    <span class="stat-num">6</span>
                    <span class="stat-label" data-i18n="stat.3">Disciplines, one team</span>
                </div>
                <div class="stat">
                    <span class="stat-num">1 day</span>
                    <span class="stat-label" data-i18n="stat.4">Typical reply time</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ PROCESS ============ -->
    <section class="section process">
        <div class="wrap">
            <div class="section-head">
                <p class="label" data-i18n="process.label">How it runs</p>
                <h2 class="h2">
                    <span data-i18n="process.title">Three steps,</span>
                    <span class="muted" data-i18n="process.title2">no theatre.</span>
                </h2>
            </div>

            <div class="process-grid">
                <div class="process-card">
                    <span class="process-num">01</span>
                    <h3 data-i18n="process.1.name">Discovery</h3>
                    <p data-i18n="process.1.desc">We map how the business actually works today, agree what success looks like, and write it down.</p>
                </div>
                <div class="process-card">
                    <span class="process-num">02</span>
                    <h3 data-i18n="process.2.name">Design &amp; build</h3>
                    <p data-i18n="process.2.desc">Weekly working software, not slide decks. You see progress in the product as it is built.</p>
                </div>
                <div class="process-card">
                    <span class="process-num">03</span>
                    <h3 data-i18n="process.3.name">Launch &amp; support</h3>
                    <p data-i18n="process.3.desc">We handle rollout, training and monitoring — and stay on for maintenance and the next phase.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ BRIEF ============ -->
    <section class="section brief" id="brief">
        <div class="wrap brief-grid">
            <div class="brief-copy">
                <p class="label label-light" data-i18n="brief.label">Start a project</p>
                <h2 class="h2 h2-light">
                    <span data-i18n="brief.title">Tell us what</span>
                    <span class="muted-light" data-i18n="brief.title2">needs building.</span>
                </h2>
                <p class="about-p" data-i18n="brief.lede">
                    Three quick questions and we will come back with a plan, a rough budget and
                    the next step. No sales script.
                </p>

                <ul class="brief-points">
                    <li><span aria-hidden="true">✳</span><span data-i18n="brief.point1">A reply within one working day</span></li>
                    <li><span aria-hidden="true">✳</span><span data-i18n="brief.point2">A named engineer on the first call</span></li>
                    <li><span aria-hidden="true">✳</span><span data-i18n="brief.point3">Fixed-scope estimate before any code</span></li>
                </ul>
            </div>

            <form class="brief-card" id="briefForm" novalidate>
                <div class="brief-progress" aria-hidden="true">
                    <span class="bar is-on"></span>
                    <span class="bar"></span>
                    <span class="bar"></span>
                </div>

                <!-- Step 1 -->
                <fieldset class="brief-step is-active" data-step="1">
                    <legend class="brief-q" data-i18n="brief.q1">What do you need?</legend>
                    <div class="chips" data-group="service">
                        <button type="button" class="chip" data-i18n="svc.1.name">Custom software</button>
                        <button type="button" class="chip" data-i18n="svc.2.name">Web platforms</button>
                        <button type="button" class="chip" data-i18n="svc.3.name">Mobile apps</button>
                        <button type="button" class="chip" data-i18n="svc.4.name">Cloud &amp; infrastructure</button>
                        <button type="button" class="chip" data-i18n="svc.5.name">Networks</button>
                        <button type="button" class="chip" data-i18n="svc.6.name">CCTV &amp; security</button>
                    </div>
                    <p class="brief-error" data-error-for="1" role="alert"></p>
                    <div class="brief-actions">
                        <button type="button" class="btn-solid btn-full" data-next="2">
                            <span data-i18n="brief.next">Continue</span>
                            <span class="arrow" aria-hidden="true">→</span>
                        </button>
                    </div>
                </fieldset>

                <!-- Step 2 -->
                <fieldset class="brief-step" data-step="2">
                    <legend class="brief-q" data-i18n="brief.q2">Budget &amp; timing</legend>
                    <p class="brief-mini" data-i18n="brief.budget">Rough budget</p>
                    <div class="chips" data-group="budget">
                        <button type="button" class="chip" data-i18n="brief.b1">Under $10k</button>
                        <button type="button" class="chip" data-i18n="brief.b2">$10k – $25k</button>
                        <button type="button" class="chip" data-i18n="brief.b3">$25k – $60k</button>
                        <button type="button" class="chip" data-i18n="brief.b4">$60k+</button>
                    </div>
                    <p class="brief-mini" data-i18n="brief.when">When should it start?</p>
                    <div class="chips" data-group="timing">
                        <button type="button" class="chip" data-i18n="brief.t1">As soon as possible</button>
                        <button type="button" class="chip" data-i18n="brief.t2">This quarter</button>
                        <button type="button" class="chip" data-i18n="brief.t3">Just exploring</button>
                    </div>
                    <p class="brief-error" data-error-for="2" role="alert"></p>
                    <div class="brief-actions brief-actions-split">
                        <button type="button" class="btn-ghost btn-full" data-back="1" data-i18n="brief.back">Back</button>
                        <button type="button" class="btn-solid btn-full" data-next="3">
                            <span data-i18n="brief.next">Continue</span>
                            <span class="arrow" aria-hidden="true">→</span>
                        </button>
                    </div>
                </fieldset>

                <!-- Step 3 -->
                <fieldset class="brief-step" data-step="3">
                    <legend class="brief-q" data-i18n="brief.q3">Where do we send the plan?</legend>
                    <div class="hp-field" aria-hidden="true">
                        <label for="briefWebsite">Website</label>
                        <input type="text" id="briefWebsite" name="website" tabindex="-1" autocomplete="off">
                    </div>
                    <label class="field">
                        <span data-i18n="brief.name">Your name</span>
                        <input type="text" name="name" id="briefName" autocomplete="name" required minlength="2" placeholder="Sara Ahmed">
                    </label>
                    <label class="field">
                        <span data-i18n="brief.email">Email</span>
                        <input type="email" name="email" id="briefEmail" autocomplete="email" required placeholder="sara@company.com">
                    </label>
                    <label class="field">
                        <span data-i18n="brief.about">Anything else?</span>
                        <textarea name="message" id="briefMessage" rows="3" data-i18n-placeholder="brief.ph" placeholder="A sentence or two about the problem…"></textarea>
                    </label>
                    <p class="brief-error" data-error-for="3" role="alert"></p>
                    <div class="brief-actions brief-actions-split">
                        <button type="button" class="btn-ghost btn-full" data-back="2" data-i18n="brief.back">Back</button>
                        <button type="submit" class="btn-solid btn-full">
                            <span data-i18n="brief.send">Send the brief</span>
                            <span class="arrow" aria-hidden="true">↗</span>
                        </button>
                    </div>
                    <p class="brief-fine" data-i18n="brief.fine">
                        Goes straight to our inbox — we keep your details only to reply to this enquiry.
                    </p>
                </fieldset>
            </form>
        </div>
    </section>
</main>

