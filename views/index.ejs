<!DOCTYPE html>
<% const isStatic = typeof staticPreview !== 'undefined' && staticPreview; %>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>True Concept — Software, Platforms &amp; Infrastructure</title>
    <meta name="description" content="True Concept is a technology studio building custom software, web platforms, mobile apps, networks and security systems for ambitious businesses.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,700;12..96,800&family=DM+Sans:wght@400;500;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/home.css">
    <script>
        /* Set the theme before paint so a dark-mode visitor never sees a white flash. */
        (function () {
            try {
                var saved = localStorage.getItem('theme');
                var dark = saved
                    ? saved === 'dark'
                    : window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (dark) document.documentElement.setAttribute('data-theme', 'dark');
            } catch (e) { /* private mode */ }
        })();
    </script>
</head>
<body>

